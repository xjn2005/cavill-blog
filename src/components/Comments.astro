<section class="mt-12" aria-label="评论">
  <div id="Comments"></div>
</section>

<script>
  import { ArtalkKatexPlugin } from "@artalk/plugin-katex";
  import Artalk from "artalk";
  import "artalk/Artalk.css";
  import "katex/dist/katex.min.css";

  Artalk.use(ArtalkKatexPlugin);

  let artalk: Artalk | undefined;

  const destroyArtalk = () => {
    artalk?.destroy();
    artalk = undefined;
  };

  const initArtalk = () => {
    destroyArtalk();

    const el = document.querySelector<HTMLElement>("#Comments");
    if (!el) return;

    artalk = Artalk.init({
      el,
      server: "https://comment.cavill.site",
      site: "Cavill Blog",
      pageKey: location.pathname,
      pageTitle: document.title,
    });
  };

  document.addEventListener("astro:page-load", initArtalk);
  document.addEventListener("astro:before-swap", destroyArtalk);
</script>
