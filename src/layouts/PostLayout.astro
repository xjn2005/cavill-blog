---
import Layout from "./Layout.astro";
import config from "@/config";
import katexCssUrl from "katex/dist/katex.min.css?url";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  keywords?: string[];
  wordCount?: number;
  hasMath?: boolean;
};

const { site } = config;

const {
  title,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  keywords,
  wordCount,
  hasMath = false,
} = Astro.props;

const siteURL = new URL(import.meta.env.BASE_URL, Astro.site ?? Astro.url).href;
const pageURL = canonicalURL
  ? new URL(canonicalURL, Astro.site ?? Astro.url).href
  : new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      headline: title ?? site.title,
      ...(description && { description }),
      ...(ogImage && {
        image: [new URL(ogImage, Astro.site ?? Astro.url).href],
      }),
      mainEntityOfPage: { "@type": "WebPage", "@id": pageURL },
      url: pageURL,
      inLanguage: site.contentLanguage,
      ...(keywords?.length && { keywords: keywords.join(", ") }),
      ...(keywords?.length && { articleSection: keywords }),
      ...(typeof wordCount === "number" && { wordCount }),
      ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
      ...(modDatetime && { dateModified: modDatetime.toISOString() }),
      author: [
        {
          "@type": "Person",
          name: site.author,
          ...(site.profile && { url: site.profile }),
        },
      ],
      publisher: {
        "@type": "Person",
        name: site.author,
        ...(site.profile && { url: site.profile }),
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: site.title, item: siteURL },
        {
          "@type": "ListItem",
          position: 2,
          name: title ?? site.title,
          item: pageURL,
        },
      ],
    },
  ],
};
---

<Layout {title} {description} {ogImage} {canonicalURL}>
  <Fragment slot="head">
    {hasMath && <link rel="stylesheet" href={katexCssUrl} />}

    <!-- Override og:type for article pages -->
    <meta property="og:type" content="article" />

    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</Layout>
